{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListCourseBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::YOUR_UNIQUE_PRIVATE_BUCKET"
    },
    {
      "Sid": "CourseImages",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::YOUR_UNIQUE_PRIVATE_BUCKET/coaches/*",
        "arn:aws:s3:::YOUR_UNIQUE_PRIVATE_BUCKET/practice/*"
      ]
    },
    {
      "Sid": "CourseEmail",
      "Effect": "Allow",
      "Action": "ses:SendEmail",
      "Resource": "arn:aws:ses:ap-northeast-1:YOUR_ACCOUNT_ID:identity/YOUR_VERIFIED_IDENTITY"
    }
  ]
}
