{
  "CORSRules": [
    {
      "AllowedHeaders": [
        "content-type",
        "x-amz-*"
      ],
      "AllowedMethods": [
        "PUT",
        "GET",
        "HEAD"
      ],
      "AllowedOrigins": [
        "https://YOUR_DOMAIN"
      ],
      "ExposeHeaders": [
        "ETag"
      ],
      "MaxAgeSeconds": 300
    }
  ]
}
