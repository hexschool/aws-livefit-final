# 填好後另存 .env.aws，權限設為 600；勿提交到 Git。
LIVEFIT_IMAGE=YOUR_ACCOUNT_ID.dkr.ecr.ap-northeast-1.amazonaws.com/livefit:aws-v1
AWS_REGION=ap-northeast-1
PORT=8080
DB_HOST=YOUR_RDS_ENDPOINT
DB_PORT=5432
DB_USERNAME=livefit
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DB_DATABASE=livefit
DB_SYNCHRONIZE=false
DB_ENABLE_SSL=true
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_VALUE
JWT_EXPIRES_DAY=1d
S3_BUCKET=YOUR_UNIQUE_PRIVATE_BUCKET
EMAIL_MODE=ses
SES_FROM_EMAIL=YOUR_VERIFIED_EMAIL
LOG_LEVEL=info
# 不放 AWS_ACCESS_KEY_ID／AWS_SECRET_ACCESS_KEY；EC2 Role 提供暫時憑證。
