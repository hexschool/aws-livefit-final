{
  "name": "aws-livefit-final",
  "version": "1.0.0",
  "private": true,
  "description": "LiveFit 已完成解答的 AWS 適配版；按 Notion 各週環節部署與驗證。",
  "scripts": {
    "start": "node .github/scripts/check-backend.js && npm --prefix backend start",
    "test": "npm run test:contracts",
    "test:m1": "jest test/m1.test.js --runInBand",
    "test:m2": "jest test/m2.test.js --runInBand",
    "test:m3": "jest test/m3.test.js --runInBand",
    "test:m4": "jest test/m4.test.js --runInBand",
    "test:m5": "jest test/m5.test.js --runInBand",
    "test:m6": "jest test/m6.test.js --runInBand",
    "test:smoke": "jest test/smoke.test.js --runInBand",
    "test:aws": "jest test/aws.test.js --runInBand",
    "test:contracts": "jest test/smoke.test.js test/m[1-6].test.js --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 15000,
    "modulePathIgnorePatterns": [
      "<rootDir>/backend/"
    ]
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jsonwebtoken": "^9.0.2",
    "supertest": "^7.0.0"
  }
}
