# 本機非 Docker 執行時使用；正式環境參閱 deploy/.env.aws.example。
PORT=8080
DB_HOST=localhost
DB_PORT=15439
DB_USERNAME=livefit
DB_PASSWORD=local-only-demo
DB_DATABASE=livefit
DB_SYNCHRONIZE=false
DB_ENABLE_SSL=false
JWT_SECRET=local-only-livefit-demo-secret
JWT_EXPIRES_DAY=1d
AWS_REGION=ap-northeast-1
S3_BUCKET=livefit-local-photos
EMAIL_MODE=disabled
SES_FROM_EMAIL=teacher@example.com
# 只有測試模擬器時才設定這三項。正式環境移除，改用 Role。
AWS_ENDPOINT_URL=http://localhost:15000
AWS_ACCESS_KEY_ID=local-test
AWS_SECRET_ACCESS_KEY=local-test
